{
 "format_version": "1.21.0",
 "minecraft:entity": {
  "description": {
   "identifier": "rocket:missile4",
   "is_spawnable": false,
   "is_summonable": true,
   "properties": {
    "rocket:flying": {
     "type": "bool",
     "client_sync": true,
     "default": false
    }
   }
  },
  "component_groups": {
   "rocket:idle": {
    "minecraft:physics": {
     "has_gravity": true,
     "has_collision": true
    },
    "minecraft:interact": {
     "interactions": [
      {
       "on_interact": {
        "filters": {
         "all_of": [
          {
           "test": "is_family",
           "subject": "other",
           "value": "player"
          }
         ]
        },
        "event": "bpla:interact",
        "target": "self"
       },
       "use_item": false,
       "interact_text": "Запустить Gerbera"
      }
     ]
    }
   },
   "rocket:flying": {
    "minecraft:physics": {
     "has_gravity": false,
     "has_collision": false
    },
    "minecraft:tick_world": {
     "radius": 2,
     "distance_to_players": 128,
     "never_despawn": true
    },
    "minecraft:timer": {
     "looping": true,
     "time": 0.05,
     "time_down_event": {
      "event": "rocket:fly_step"
     }
    },
    "minecraft:damage_sensor": {
     "triggers": [
      {
       "cause": "all",
       "on_damage": {
        "event": "rocket:explode"
       },
       "deals_damage": "no"
      }
     ]
    },
    "minecraft:pushable": {
     "is_pushable": false,
     "is_pushable_by_piston": false
    }
   },
   "rocket:exploding": {
    "minecraft:explode": {
     "fuse_length": 0.05,
     "fuse_lit": true,
     "power": 8,
     "causes_fire": true,
     "breaks_blocks": true
    }
   },
   "rocket:route_ticking": {
    "minecraft:tick_world": {
     "radius": 2,
     "distance_to_players": 128,
     "never_despawn": true
    },
    "minecraft:physics": {
     "has_gravity": false,
     "has_collision": false
    },
    "minecraft:pushable": {
     "is_pushable": false,
     "is_pushable_by_piston": false
    }
   },
   "rocket:mounted": {
    "minecraft:physics": {
     "has_gravity": false,
     "has_collision": false
    },
    "minecraft:interact": {
     "interactions": [
      {
       "on_interact": {
        "filters": {
         "all_of": [
          {
           "test": "is_family",
           "subject": "other",
           "value": "player"
          }
         ]
        },
        "event": "bpla:interact",
        "target": "self"
       },
       "use_item": false,
       "interact_text": "Запустить Gerbera"
      }
     ]
    },
    "minecraft:pushable": {
     "is_pushable": false,
     "is_pushable_by_piston": false
    }
   }
  },
  "components": {
   "minecraft:collision_box": {
    "width": 0.1,
    "height": 0.1
   },
   "minecraft:pushable": {
    "is_pushable": false,
    "is_pushable_by_piston": false
   },
   "minecraft:health": {
    "value": 20,
    "max": 20
   },
   "minecraft:type_family": {
    "family": [
     "rocket"
    ]
   },
   "minecraft:custom_hit_test": {
    "hitboxes": [
     {
      "pivot": [
       0,
       0.6,
       0
      ],
      "width": 2.5,
      "height": 1.2
     }
    ]
   },
   "minecraft:damage_sensor": {
    "triggers": [
     {
      "cause": "all",
      "deals_damage": "no"
     }
    ]
   }
  },
  "events": {
   "minecraft:entity_spawned": {
    "sequence": [
     {
      "add": {
       "component_groups": [
        "rocket:idle"
       ]
      }
     },
     {
      "queue_command": {
       "command": "scoreboard objectives add rocket_snd dummy"
      }
     },
     {
      "queue_command": {
       "command": "scoreboard objectives add rocket_launch dummy"
      }
     }
    ]
   },
   "rocket:start_flight": {
    "sequence": [
     {
      "remove": {
       "component_groups": [
        "rocket:idle",
        "rocket:mounted"
       ]
      }
     },
     {
      "add": {
       "component_groups": [
        "rocket:flying"
       ]
      }
     },
     {
      "set_property": {
       "rocket:flying": true
      }
     },
     {
      "queue_command": {
       "command": "scoreboard players set @s rocket_snd 0"
      }
     },
     {
      "queue_command": {
       "command": "scoreboard players set @s rocket_launch 0"
      }
     },
     {
      "queue_command": {
       "command": "execute at @s run playsound firework.launch @a ~ ~ ~ 3.0 0.7"
      }
     },
     {
      "queue_command": {
       "command": "execute at @s run playsound custom.shahed3.fly @a ~ ~ ~ 10.0 0.8"
      }
     }
    ]
   },
   "rocket:fly_step": {
    "sequence": [
     {
      "queue_command": {
       "command": "function shahed3/fly_step"
      }
     }
    ]
   },
   "rocket:explode": {
    "sequence": [
     {
      "queue_command": {
       "command": "execute at @s run function shahed3/explode"
      }
     },
     {
      "set_property": {
       "rocket:flying": false
      }
     },
     {
      "remove": {
       "component_groups": [
        "rocket:flying"
       ]
      }
     },
     {
      "add": {
       "component_groups": [
        "rocket:exploding"
       ]
      }
     }
    ]
   },
   "rocket:route_start": {
    "sequence": [
     {
      "set_property": {
       "rocket:flying": true
      }
     },
     {
      "remove": {
       "component_groups": [
        "rocket:idle",
        "rocket:mounted"
       ]
      }
     },
     {
      "add": {
       "component_groups": [
        "rocket:route_ticking"
       ]
      }
     }
    ]
   },
   "rocket:mount": {
    "sequence": [
     {
      "remove": {
       "component_groups": [
        "rocket:idle"
       ]
      }
     },
     {
      "add": {
       "component_groups": [
        "rocket:mounted"
       ]
      }
     }
    ]
   },
   "bpla:interact": {
    "add": {
     "component_groups": []
    }
   }
  }
 }
}
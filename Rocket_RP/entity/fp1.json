{
 "format_version": "1.10.0",
 "minecraft:client_entity": {
  "description": {
   "identifier": "rocket:missile7",
   "materials": {
    "default": "entity_alphatest"
   },
   "textures": {
    "default": "textures/entity/firepoint1"
   },
   "geometry": {
    "default": "geometry.firepoint1_drone"
   },
   "scripts": {
    "animate": [
     {
      "transform": "1.0"
     },
     {
      "propeller_spin": "query.property('rocket:flying') ? 1.0 : 0.0"
     }
    ],
    "pre_animation": [
     "variable.uav_dt = math.clamp(query.delta_time, 0, 0.1);",
     "variable.uav_pitch = math.lerp(variable.uav_pitch ?? query.target_x_rotation, query.target_x_rotation, math.clamp(variable.uav_dt * 8, 0, 1));",
     "variable.uav_roll = math.lerp(variable.uav_roll ?? 0, math.clamp(query.yaw_speed * -0.9, -35, 35), math.clamp(variable.uav_dt * 3, 0, 1));"
    ]
   },
   "animations": {
    "transform": "animation.firepoint1.transform",
    "propeller_spin": "animation.firepoint1.propeller_spin"
   },
   "render_controllers": [
    "controller.render.default"
   ],
   "sound_effects": {
    "hurt": ""
   }
  }
 }
}